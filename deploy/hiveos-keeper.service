[Unit]
Description=HiveOS memory consolidation (sleep-time compute, oneshot)

[Service]
Type=oneshot
User=hive
WorkingDirectory=/home/hive/HiveOS
EnvironmentFile=/home/hive/HiveOS/.env
# `hive consolidate` runs one keeper pass and exits; driven by the .timer below.
ExecStart=/home/hive/HiveOS/.venv/bin/hive consolidate
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hive/HiveOS/data /home/hive/HiveOS/vault /home/hive/HiveOS/.worktrees
PrivateTmp=true
