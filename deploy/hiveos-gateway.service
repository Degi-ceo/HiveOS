[Unit]
Description=HiveOS Gateway (FastAPI: /chat /chat/stream /ws /approvals /budget /telegram/webhook)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/hive/HiveOS
EnvironmentFile=/home/hive/HiveOS/.env
# Seed identity/system facts into memory on every start (fail-open: || true).
ExecStartPre=/bin/bash -c 'cd /home/hive/HiveOS && .venv/bin/python scripts/seed_memories.py || true'
# `hive serve` builds HiveOS and runs uvicorn on HIVE_HOST:HIVE_PORT.
ExecStart=/home/hive/HiveOS/.venv/bin/hive serve
Restart=always
RestartSec=5
# Hardening — ProtectHome=read-only because HiveOS lives in /home/hive.
# ReadWritePaths exceptions allow data/, vault/, and self-mod worktrees.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hive/HiveOS/data /home/hive/HiveOS/vault /home/hive/HiveOS/.worktrees
PrivateTmp=true

[Install]
WantedBy=default.target
