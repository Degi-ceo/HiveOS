[Unit]
Description=HiveOS Autonomy (never-idle heartbeat: cron + commitments + tasks)
After=hiveos-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/hive/HiveOS
EnvironmentFile=/home/hive/HiveOS/.env
# `hive heartbeat` runs the 24/7 autonomy loop.
ExecStart=/home/hive/HiveOS/.venv/bin/hive heartbeat
Restart=always
RestartSec=10
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hive/HiveOS/data /home/hive/HiveOS/vault /home/hive/HiveOS/.worktrees /home/hive/HiveOS/.git
PrivateTmp=true

[Install]
WantedBy=default.target
