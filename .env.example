# HiveOS environment — copy to .env and fill in. Secrets ONLY here.
# (referenced by scripts/setup.sh; loaded by src/hive/core/config.py)

# --- MiniMax (primary executor) ---
MINIMAX_API_KEY=
MINIMAX_ANTHROPIC_BASE=https://api.minimax.io/anthropic
MINIMAX_OPENAI_BASE=https://api.minimax.io/v1
HIVE_EXEC_MODEL=MiniMax-M3
HIVE_EXEC_FALLBACK_MODEL=MiniMax-M2.7
HIVE_AUX_MODEL=MiniMax-M2.7
HIVE_REMAINS_URL=https://api.minimax.io/v1/token_plan/remains

# --- Storage (defaults derive from the repo root; override to relocate) ---
HIVE_DATA_DIR=
HIVE_STATE_DB=

# --- ChatGPT Plus planner (heavy planning only, via Codex OAuth) ---
HIVE_PLANNER_ENABLED=false
HIVE_PLANNER_CMD=codex exec
HIVE_PLANNER_TIMEOUT=120

# --- Gateway ---
HIVE_HOST=0.0.0.0
HIVE_PORT=8088
HIVE_SECRET=change_me

# --- Memory ---
# MNEMOSYNE_HOME: writable dir for the local Mnemosyne SQLite DB.
#   Leave blank to use <HIVE_DATA_DIR>/mnemosyne (default).
#   Set to point an existing Mnemosyne install.
MNEMOSYNE_HOME=
# MNEMOSYNE_MCP_URL: MCP endpoint of a remote Mnemosyne server (future; unused today).
MNEMOSYNE_MCP_URL=
OBSIDIAN_VAULT_PATH=

# --- Autonomy ---
HIVE_HEARTBEAT_SEC=900
HIVE_MAX_AGENTS=3

# --- Budgeter ---
HIVE_DAILY_CALL_CAP=3000
HIVE_WINDOW_WARN_PCT=70

# --- Hive's own GitHub identity ---
HIVE_GITHUB_TOKEN=
HIVE_GITHUB_REPO=
HIVE_GITHUB_OWNER=

# --- Telegram surface (optional) ---
# Bot token from @BotFather; webhook secret is the X-Telegram-Bot-Api-Secret-Token
# you pass to setWebhook (verified on every inbound update).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Self-mod sandbox (optional) ---
# Docker image to run candidate self-mod test suites in (isolated, no network).
# Leave blank to run tests locally.
HIVE_SANDBOX_IMAGE=

# --- MCP servers (optional) ---
# ';'-separated stdio command lines; their tools are loaded into the registry at
# gateway/heartbeat startup. Example:
#   HIVE_MCP_SERVERS=npx -y @modelcontextprotocol/server-filesystem /data;other-server --flag
HIVE_MCP_SERVERS=
