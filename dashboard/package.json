    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.62.1",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
